# Copy this file to .env for manual Docker Compose usage.
# The included start.ps1 launcher creates secure local values automatically.

PORT=4444
POSTGRES_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-a-long-random-secret

# Local default: built-in username/password authentication.
PCHAT_AUTH_PROVIDERS=credentials
PCHAT_ALLOW_REGISTRATION=true

# Optional AI features. Leave disabled unless an API key is configured.
PCHAT_FEATURE_AI_SEARCH=false
PCHAT_FEATURE_AI_GENERATION=false
OPENAI_API_KEY=
